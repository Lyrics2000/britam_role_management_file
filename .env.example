############################################################################
# Copy this file to `.env` in the same directory as docker-compose.yml,
# fill in the values, then run:  docker compose up -d --build
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real values.
############################################################################

# --- REQUIRED ------------------------------------------------------------

# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be at least 32 characters. Changing it logs everyone out.
DJANGO_SECRET_KEY=CHANGE_ME_generate_a_long_random_string_at_least_32_chars

# Comma-separated hostnames/IPs the site will be reached on.
# "*" is rejected when DJANGO_DEBUG=0.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,roles.example.com

# --- FIRST EDITOR ACCOUNT ------------------------------------------------
# Created on first boot only, and skipped entirely if a superuser already
# exists. Leave the password blank to skip and create the account manually
# with: docker compose exec web python manage.py createsuperuser
# Minimum 12 characters, and it is checked against Django's common-password
# list — "password1234" will be refused.
DJANGO_SUPERUSER_USERNAME=hradmin
DJANGO_SUPERUSER_EMAIL=hr.systems@example.com
DJANGO_SUPERUSER_PASSWORD=

# --- SEEDING -------------------------------------------------------------
# once = load Britam_Role_Library.html only when the database is empty
#        (edits made in the app survive restarts)  <-- recommended
# sync = re-read the HTML on every boot and update changed rows
#        (the HTML file stays the source of truth)
# off  = never seed
SEED_MODE=once

# --- OPTIONAL: AI ASSISTANT ---------------------------------------------
# Leave blank to keep the AI tab disabled. The key is used server-side only
# and is never sent to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_TIMEOUT=45
# Hard ceiling on successful AI calls per rolling 24h, shared across workers.
AI_DAILY_BUDGET_REQUESTS=500

# --- PUBLIC PORT ---------------------------------------------------------
# The port the browser connects on — 6519 unless you changed the ports mapping
# in docker-compose.yml. Django compares the browser's Origin header against
# its own host:port on every POST, so this must match what users actually type
# or the sign-in form fails with "CSRF verification failed".
# Set to blank when the site is served on 80 (http) or 443 (https).
PUBLIC_PORT=6519

# --- OPTIONAL: TLS -------------------------------------------------------
# Turn this on ONLY once HTTPS terminates in front of this stack (Caddy,
# Traefik, Cloudflare, or an nginx with a certificate). Enabling it without
# TLS makes cookies secure-only and sign-in will appear to silently fail.
DJANGO_BEHIND_TLS_PROXY=0
DJANGO_SECURE_SSL_REDIRECT=0
# Extra origins allowed to POST, beyond the ones derived automatically from
# DJANGO_ALLOWED_HOSTS + PUBLIC_PORT. Scheme required. Usually only needed
# behind Cloudflare or a second domain, e.g.
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://roles.britam.com,https://www.roles.britam.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- OPTIONAL: TUNING ----------------------------------------------------
DJANGO_DEBUG=0
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=Africa/Nairobi
DJANGO_SESSION_AGE=28800
DJANGO_SQLITE_TIMEOUT=20
GUNICORN_WORKERS=3
APP_VERSION=1.0.0

# Requests per minute per IP, enforced in the app (nginx also rate-limits).
THROTTLE_ROLES_READ=600/min
THROTTLE_ROLES_WRITE=60/min
THROTTLE_AI=10/min
